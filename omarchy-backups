#!/usr/bin/env bash
# OmaBackups CLI — engine for the plugin and the boot restore TUI.
set -euo pipefail

OMARCHY_TM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export OMARCHY_TM_ROOT OMARCHY_BACKUPS_ROOT="$OMARCHY_TM_ROOT"
# shellcheck source=lib/common.sh
source "$OMARCHY_TM_ROOT/lib/common.sh"

OMA_VERSION="$(cat "$OMARCHY_TM_ROOT/VERSION" 2>/dev/null || echo unknown)"

usage() {
  cat <<EOF
oma-backups $OMA_VERSION — encrypted backups of this Omarchy system and home

Destructive: setting up a disk and restoring both wipe a disk. Keep another
copy of anything you cannot lose until you have booted a restored disk.

Every day
  backup [--yes] [--home-only] [--force-after-restore]
                          back up now
  stop                    stop the backup that is running
  status                  what it is doing, as JSON
  snapshots [--json]      the restore points on the backup disk
  open TIMESTAMP          open one restore point read-only in Files
  browse TIMESTAMP        the same, held open until stopped (the plugin uses this)
  put-back-system         after a quick restore, put back the AI models it left
                          on the backup (the plugin's Restore my files runs it)
  prune [--dry-run]       thin out old restore points now
  schedule enable | disable | status | run
                          automatic backups

Setting up
  disks [--all] [--json]  disks that could be used
  first-run /dev/sdX      set up a disk, ready for its first backup
  format-disk /dev/sdX [--yes] [--force] [--skip-live] [--iso PATH]
                          set up a disk and nothing else
  link [--refresh]        stop everyday actions asking for a password
  mount [--disk /dev/sdX] unlock and mount the backup disk
  umount                  unmount it and lock it again

A Raspberry Pi
  remote pair HOST        keep the backup disk in an always-on Pi
  remote status | forget
  rescue-stick /dev/sdX [--iso PATH]
                          make a USB that restores from the Pi

Restoring
  restore-to-disk /dev/TARGET --snapshot TIMESTAMP
      [--level full|settings] [--from-pi] [--yes] [--allow-internal]
                          put a restore point onto a blank disk
  restore-tui             the restore wizard the rescue USB boots into
  refresh-rescue [--scripts-only | --boot-only]
                          update a rescue USB (--scripts-only: just the
                          wizard and scripts, in seconds, after an update)
  files TIMESTAMP [PATH]  list what is inside a restore point
  copy TIMESTAMP SRC DEST copy one thing out of a restore point

Looking into things
  detect [--json]         is this machine supported, and what is plugged in
  doctor                  check the skip list against what was backed up
  init-config             write the config and skip-list files
  compile-excludes        rebuild the rsync excludes from the skip list
  root                    where this copy of OmaBackups lives
  version

With any of the above
  --dry-run               say what would happen and change nothing
  --yes                   do not stop to confirm
  --allow-internal        allow an internal disk as the target (USB is the default)
  --force                 go ahead on a disk that already holds backups
  --home-only             back up your home folder and not the system

USB disks only by default; an internal disk needs --all or --allow-internal.
The disk this computer is running from is always refused.
EOF
}

init_config() {
  require_root init-config
  local etc=/etc/omarchy-backups
  mkdir -p "$etc"
  if [[ ! -f $etc/config.toml ]]; then
    cp "$OMARCHY_TM_ROOT/share/defaults.toml" "$etc/config.toml"
    log "wrote $etc/config.toml"
  fi
  "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/compile_excludes.py"
  chmod 644 "$etc"/*.txt "$etc"/config.toml 2>/dev/null || true
  echo "Config in $etc and ~/.config/omarchy-backups"
  echo "User skip list: ~/.config/omarchy-backups/skip-paths.txt"
}

disks_cmd() {
  local all=0 json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1; shift ;;
      --json) json=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  local raw
  raw="$("$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/detect.py" --json)"
  if [[ $json == 1 ]]; then
    if [[ $all == 1 ]]; then
      printf '%s\n' "$raw" | jq '{hostname, live_root_disk, disks}'
    else
      printf '%s\n' "$raw" | jq '{
        hostname, live_root_disk,
        disks: [.disks[] | select(.hidden_by_default != true)]
      }'
    fi
    return 0
  fi
  if [[ $all == 1 ]]; then
    printf '%s\n' "$raw" | jq -r '
      .disks[] |
      "\(.path)\t\(.size // "?")\t\(.tran // "-")\t\(.kind)\t\(.model // "")\t\((.labels // []) | join(","))\(if .protected then "\tREFUSE:"+(.protected_reason // "") else "" end)"
    '
  else
    printf '%s\n' "$raw" | jq -r '
      .disks[] | select(.hidden_by_default != true) |
      "\(.path)\t\(.size // "?")\t\(.tran // "-")\t\(.kind)\t\(.model // "")\t\((.labels // []) | join(","))"
    '
  fi
}

while [[ $# -gt 0 ]]; do
  case "${1:-}" in
    --dry-run) export OMARCHY_TM_DRY_RUN=1; shift ;;
    --yes) export OMARCHY_TM_YES=1; shift ;;
    --force) export OMARCHY_TM_FORCE=1; shift ;;
    --allow-internal) export OMARCHY_TM_ALLOW_INTERNAL=1; shift ;;
    --home-only) export OMARCHY_TM_HOME_ONLY=1; shift ;;
    *) break ;;
  esac
done

cmd="${1:-}"
shift || true

case "$cmd" in
  -h|--help|help|"") usage; exit 0 ;;
  detect) exec "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/detect.py" "$@" ;;
  init-config) init_config ;;
  format-disk) exec "$OMARCHY_TM_ROOT/format-disk.sh" "$@" ;;
  mount|umount) exec "$OMARCHY_TM_ROOT/mount.sh" "$cmd" "$@" ;;
  backup)
    extra=()
    [[ ${OMARCHY_TM_HOME_ONLY:-0} == 1 ]] && extra+=(--home-only)
    exec "$OMARCHY_TM_ROOT/backup.sh" "$@" "${extra[@]}"
    ;;
  snapshots)
    extra=()
    [[ ${1:-} == --json ]] && extra+=(--json)
    exec "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/list_snapshots.py" "${extra[@]}"
    ;;
  open)
    ts=${1:-}
    [[ -n $ts ]] || die "usage: oma-backups open TIMESTAMP"
    exec "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/list_snapshots.py" --open "$ts"
    ;;
  files) exec "$OMARCHY_TM_ROOT/backup.sh" --files "$@" ;;
  copy) exec "$OMARCHY_TM_ROOT/backup.sh" --copy "$@" ;;
  restore-to-disk) exec "$OMARCHY_TM_ROOT/restore-to-disk.sh" "$@" ;;
  restore-tui) exec "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/restore_tui.py" "$@" ;;
  refresh-rescue) exec "$OMARCHY_TM_ROOT/refresh-rescue.sh" "$@" ;;
  rescue-stick) exec "$OMARCHY_TM_ROOT/rescue-stick.sh" "$@" ;;
  remote) exec "$OMARCHY_TM_ROOT/remote.sh" "$@" ;;
  link) exec "$OMARCHY_TM_ROOT/link.sh" "$@" ;;
  browse) exec "$OMARCHY_TM_ROOT/backup.sh" --browse "$@" ;;
  put-back-system) exec "$OMARCHY_TM_ROOT/backup.sh" --put-back-system "$@" ;;
  prune) exec "$OMARCHY_TM_ROOT/backup.sh" --prune "$@" ;;
  schedule) exec "$OMARCHY_TM_ROOT/schedule.sh" "$@" ;;
  compile-excludes)
    exec "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/compile_excludes.py" "$@"
    ;;
  doctor)
    exec "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/doctor.py" "$@"
    ;;
  disks) disks_cmd "$@" ;;
  first-run)
    disk=${1:-}
    [[ -n $disk ]] || die "usage: oma-backups first-run /dev/sdX"
    init_config
    "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/compile_excludes.py"
    echo "Using excludes from skip-paths + defaults"
    export OMARCHY_TM_YES=1
    # Switching disks: lock the old backup disk first, or the new one's first
    # backup would go to whichever is still mounted.
    "$OMARCHY_TM_ROOT/mount.sh" umount >/dev/null 2>&1 || true
    # format-disk adds this laptop's key while it has the new password, so
    # nothing after setup ever asks for it again.
    create_capsule_key
    "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/progress.py" phase setup || true
    if ! "$OMARCHY_TM_ROOT/format-disk.sh" "$disk" --yes --force; then
      "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/progress.py" fail "USB setup failed" || true
      echo "Setup failed. Existing backups were not wiped. Not starting a backup."
      # format-disk.sh can die() before it reaches its own "press enter" pause
      # (e.g. a missing dependency) — pause here too, or the plugin's terminal
      # closes before the error above is readable.
      [[ -r /dev/tty ]] && read -r -p "Press Enter to close." _ </dev/tty
      exit 1
    fi
    "$OMARCHY_TM_ROOT/link.sh" --quiet || echo "Couldn't link this laptop; backups will ask for your password. Try: oma-backups link"
    "$OMARCHY_TM_PYTHON" "$OMARCHY_TM_ROOT/lib/progress.py" idle || true
    # Setup ends here. The first backup is a big job and it is the user's to
    # start, once they have looked through the settings — not something that
    # begins on its own the moment a disk is set up.
    echo
    echo "Backup disk ready. Nothing has been copied to it yet."
    echo "Open the OmaBackups icon on the bar, set up what to skip, then press Backup now."
    [[ -r /dev/tty ]] && read -r -p "Press Enter to close." _ </dev/tty
    ;;
  stop)
    require_root stop
    stop_backup
    ;;
  status) status_json ;;
  root) printf '%s\n' "$OMARCHY_TM_ROOT" ;;
  version) echo "oma-backups $OMA_VERSION" ;;
  *)
    log_err "unknown command: $cmd"
    usage >&2
    exit 1
    ;;
esac
