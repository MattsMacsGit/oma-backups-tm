#!/usr/bin/env bash
# oma-migrate — pick what comes back after a fresh install of Omarchy.
# Part of OmaBackups: the picks are saved in the home folder, so backups carry them.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY="${OMARCHY_TM_PYTHON:-/usr/bin/python3}"
[[ -x $PY ]] || PY="$(command -v python3)"

usage() {
  cat <<USAGE
oma-migrate $(cat "$ROOT/VERSION" 2>/dev/null || echo) — pick what comes back after a fresh install

  oma-migrate             Prepare for a fresh install: go through the list,
                          pick, and save your config
  oma-migrate show        print your saved config
  oma-migrate scan        what you added on top of Omarchy, as a plain list
  oma-migrate scan --json the same, for scripts
  oma-migrate connect PI-NAME
                          Connect to your old backup on a Pi (pairs over the
                          network; the backup disk stays in the Pi)
  oma-migrate connect     Connect to your old backup on the USB disk plugged in
  oma-migrate apply --dry-run [TIMESTAMP]
                          Migrate my saved config, as a dry run: read your saved config out of
                          the newest restore point and say what it would do
  oma-migrate apply [TIMESTAMP]
                          Migrate my saved config: install the apps in your saved config and
                          bring their settings back (on a fresh install)
  oma-migrate apply --into FOLDER
                          copy the settings into FOLDER instead, to try it out:
                          no installs, nothing else touched

Your config is saved in ~/.config/omarchy-backups/migrate.json, so your next
backup carries it. Opening the picker again shows that saved config, also
after a fresh install, so you can pick something you left behind. "Scan
again" in the picker replaces it with a fresh scan of this computer: do that
when you're planning your next fresh install.
USAGE
}

case "${1:-}" in
  "" | pick) exec "$PY" "$ROOT/lib/migrate_pick.py" ;;
  show) exec "$PY" "$ROOT/lib/migrate_pick.py" --show ;;
  connect)
    # Connect to your old backup: a Pi by name (pairs over the network), or
    # the OmaBackups disk plugged in here.
    shift
    if [[ -n ${1:-} && ${1:-} != /dev/* ]]; then
      exec sudo --preserve-env=OMARCHY_TM_PYTHON,OMA_REPO_RAW "$ROOT/omarchy-backups" remote pair "$1"
    fi
    exec sudo --preserve-env=OMARCHY_TM_PYTHON "$ROOT/omarchy-backups" connect "$@" ;;
  scan) shift; exec "$PY" "$ROOT/lib/migrate_scan.py" "$@" ;;
  apply)
    shift
    # sudo asks on the terminal itself, so this works with the output piped too.
    sub=migrate-apply
    if [[ ${1:-} == --dry-run ]]; then sub=migrate-plan; shift; fi
    if [[ $EUID -ne 0 ]]; then
      exec sudo --preserve-env=OMARCHY_TM_PYTHON,OMARCHY_TM_YES "$ROOT/omarchy-backups" "$sub" "$@"
    fi
    exec "$ROOT/omarchy-backups" "$sub" "$@" ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
