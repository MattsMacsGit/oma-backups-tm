#!/usr/bin/env bash
# oma-migrate — pick what comes back after a fresh install of Omarchy.
# Part of OmaBackups: the picks are saved in the home folder, so backups carry them.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY="${OMARCHY_TM_PYTHON:-/usr/bin/python3}"
[[ -x $PY ]] || PY="$(command -v python3)"

# sudo's own prompt ("[sudo] password for you:") reads as if it wants the
# Pi's password when it comes straight after asking for the Pi's login. It
# wants this computer's, so every sudo here says so, and laptop_password asks
# for it up front, with the reason, before anything about the Pi.
SUDO_PROMPT="  Password for $USER on THIS computer: "

# Ask for this computer's password now (sudo then remembers it for a few
# minutes), saying why. Nothing is shown when sudo already has it.
laptop_password() {
  [[ $EUID -eq 0 ]] && return 0
  sudo -n true 2>/dev/null && return 0
  echo
  gum style --bold "This computer's password"
  gum style --foreground 8 "  $1"
  gum style --foreground 8 "  Type the password you log in to THIS computer with (as $USER)."
  gum style --foreground 8 "  Not the Pi's password: that comes later, and it'll say so."
  sudo -v -p "$SUDO_PROMPT" || { echo "That wasn't this computer's password, so nothing was changed."; exit 1; }
}

usage() {
  cat <<USAGE
oma-migrate $(cat "$ROOT/VERSION" 2>/dev/null || echo) — pick what comes back after a fresh install

  oma-migrate             Prepare for a fresh install: go through the list,
                          pick, and save your config
  oma-migrate show        print your saved config
  oma-migrate scan        what you added on top of Omarchy, as a plain list
  oma-migrate scan --json the same, for scripts
  oma-migrate connect PI-NAME
                          Connect to your old backup on a Pi (pairs over the
                          network; the backup disk stays in the Pi)
  oma-migrate connect     Connect to your old backup on the USB disk plugged in
  oma-migrate apply --dry-run [TIMESTAMP]
                          Migrate my saved config, as a dry run: read your saved config out of
                          the newest restore point and say what it would do
  oma-migrate apply [TIMESTAMP]
                          Migrate my saved config: install the apps in your saved config and
                          bring their settings back (on a fresh install)
  oma-migrate apply --into FOLDER
                          copy the settings into FOLDER instead, to try it out:
                          no installs, nothing else touched

Your config is saved in ~/.config/omarchy-backups/migrate.json, so your next
backup carries it. Opening the picker again shows that saved config, also
after a fresh install, so you can pick something you left behind. "Scan
again" in the picker replaces it with a fresh scan of this computer: do that
when you're planning your next fresh install.
USAGE
}

case "${1:-}" in
  "" | pick) exec "$PY" "$ROOT/lib/migrate_pick.py" ;;
  show) exec "$PY" "$ROOT/lib/migrate_pick.py" --show ;;
  connect)
    # Connect to your old backup: a Pi by name (pairs over the network), or
    # the OmaBackups disk plugged in here.
    shift
    laptop_password "Connecting to your old backup changes settings on this computer, which needs your password."
    if [[ -n ${1:-} && ${1:-} != /dev/* ]]; then
      exec sudo -p "$SUDO_PROMPT" --preserve-env=OMARCHY_TM_PYTHON,OMA_REPO_RAW "$ROOT/omarchy-backups" remote pair "$1"
    fi
    exec sudo -p "$SUDO_PROMPT" --preserve-env=OMARCHY_TM_PYTHON "$ROOT/omarchy-backups" connect "$@" ;;
  scan) shift; exec "$PY" "$ROOT/lib/migrate_scan.py" "$@" ;;
  apply)
    shift
    # sudo asks on the terminal itself, so this works with the output piped too.
    sub=migrate-apply
    if [[ ${1:-} == --dry-run ]]; then sub=migrate-plan; shift; fi
    # On a fresh install nothing is connected yet: Connect to your old backup
    # first (the backup disk plugged in here, or a Pi by name), then go on.
    if [[ ! -f /etc/omarchy-backups/capsule.json && ! -f /etc/omarchy-backups/remote.json ]]; then
      echo
      gum style --bold "First: Connect to your old backup"
      gum style --foreground 8 "  This asks for a few things, one at a time, and says each time which one:"
      gum style --foreground 8 "    1. THIS computer's password (to change settings here)"
      gum style --foreground 8 "    2. If your backups are on a Pi: its address, your login name on it, then"
      gum style --foreground 8 "       the Pi's password (once to log in, maybe once more for sudo on the Pi)"
      gum style --foreground 8 "    3. Maybe the backup disk's password (the one you chose when setting it up)"
      laptop_password "Connecting to your old backup changes settings on this computer, which needs your password."
      if lsblk -nr -o LABEL 2>/dev/null | grep -qxE 'OMABOOT|OMARCHY-EFI|OmaRescue|OMARCHY-LIVE'; then
        gum style --foreground 8 "  A backup disk is plugged in here."
        if gum confirm "Use the backup disk plugged in here?"; then
          sudo -p "$SUDO_PROMPT" --preserve-env=OMARCHY_TM_PYTHON "$ROOT/omarchy-backups" connect || exit 1
        fi
      fi
      if [[ ! -f /etc/omarchy-backups/capsule.json && ! -f /etc/omarchy-backups/remote.json ]]; then
        echo
        gum style --bold "The Pi's address"
        gum style --foreground 8 "  Backups on a Pi? Type its address on your home network, like 192.168.1.50"
        gum style --foreground 8 "  (your router's app lists it). A Tailscale name won't work yet: Tailscale"
        gum style --foreground 8 "  comes back with your settings. Or press Esc, plug in the backup disk and start again."
        while true; do
          pi="$(gum input --header "The Pi's address (IP on your home network)" --placeholder "e.g. 192.168.1.50")" || exit 1
          [[ -n $pi ]] || exit 1
          if [[ ! $pi =~ ^[A-Za-z0-9._:-]+$ ]]; then
            echo "That doesn't look like an address. Try again."
            continue
          fi
          echo
          gum style --bold "Your login name on the Pi"
          gum style --foreground 8 "  The user name you sign in to the Pi with, e.g. pi or matt (as in ssh NAME@$pi)."
          gum style --foreground 8 "  Just the name here: its password is asked for in a moment."
          who="$(gum input --header "Login name on the Pi at $pi" --value "$USER")" || exit 1
          if [[ ! $who =~ ^[a-z_][a-z0-9_.-]*$ ]]; then
            echo "That doesn't look like a login name. Try again."
            continue
          fi
          # A pairing that fails changes nothing, so another try starts clean.
          if sudo -p "$SUDO_PROMPT" --preserve-env=OMARCHY_TM_PYTHON,OMA_REPO_RAW "$ROOT/omarchy-backups" remote pair "$who@$pi"; then
            break
          fi
          echo
          gum confirm "Try again with a different address or login?" || exit 1
        done
      fi
      [[ -f /etc/omarchy-backups/capsule.json || -f /etc/omarchy-backups/remote.json ]] ||
        { echo "Not connected to a backup, so there's nothing to migrate from yet."; exit 1; }
      echo
      gum style --bold "Now: Migrate my saved config"
    fi
    if [[ $EUID -ne 0 ]]; then
      laptop_password "Putting your saved config back changes settings on this computer, which needs your password."
      exec sudo -p "$SUDO_PROMPT" --preserve-env=OMARCHY_TM_PYTHON,OMARCHY_TM_YES "$ROOT/omarchy-backups" "$sub" "$@"
    fi
    exec "$ROOT/omarchy-backups" "$sub" "$@" ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
