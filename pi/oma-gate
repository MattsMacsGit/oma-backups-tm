#!/usr/bin/env python3
"""OmaBackups gatekeeper: the only thing the laptop's SSH key can run here.

sshd forces every login by that key through `sudo oma-gate`, so this runs as
root. The request arrives in SSH_ORIGINAL_COMMAND and must be one of the verbs
in VERBS; anything else is refused. It only ever touches the one LUKS disk
pinned in gate.conf, mounted at /run/omarchy-backups, and only the top-level
backup layout inside it (os/, home/, esp/, meta/).

A network rescue stick has its own key, forced through `oma-gate --rescue`:
it can unlock with the disk password, list, read, and lock. Nothing else.
"""

from __future__ import annotations

import fcntl
import json
import os
import pwd
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import syslog
import time
from contextlib import contextmanager
from pathlib import Path

VERSION = "12"
LIB = Path(__file__).resolve().parent
MAPPER = "oma-capsule"
TOP_DIRS = {"os", "home", "esp", "meta"}
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
STAMP = re.compile(r"^\d{8}T\d{6}Z$")
UUID = re.compile(r"^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")
LOW_PRIORITY = ["nice", "-n", "10", "ionice", "-c2", "-n7"]
MAX_KEY = 8192
MAX_META = 1 << 20
ACCOUNT = "omabackups"
RESCUE_TAG = "oma-rescue"
PUBKEY = re.compile(r"^ssh-ed25519 [A-Za-z0-9+/=]+$")
RESCUE = sys.argv[1:] == ["--rescue"]

# Non-root runs are tests only: they may point the gate at a scratch folder.
# In production sudo strips the environment, and root never reads these.
TEST = os.geteuid() != 0
CONF = Path(os.environ.get("OMA_GATE_CONF", "")) if TEST else Path("/etc/oma-backups/gate.conf")
MOUNT = Path(os.environ.get("OMA_GATE_MOUNT", "")) if TEST else Path("/run/omarchy-backups")
# Unlocking a disk here takes many seconds (no AES instructions on a Pi), and
# each request is its own process. Without this, a lock arriving mid-unlock
# saw nothing open yet, locked nothing, and the unlock landed behind it and
# left the disk open -- which is what a Stop pressed while unlocking did.
# The fallback matters: an empty path here made `with_name` below raise on
# import, so a test run that set the other three variables but not this one
# died before it could answer anything. Production never reaches it (root is
# not TEST) — it is only the test harness that could trip over it.
CAPSULE_LOCK = Path(os.environ.get("OMA_GATE_LOCK") or "/tmp/oma-gate-test.capsule.lock") if TEST else Path("/run/oma-gate.capsule.lock")
# A lock request leaves this behind while it queues. If the laptop is killed
# before its turn comes (a Stop cut short by a short service timeout), the
# unlock it was chasing finishes, sees the note, and locks up after itself.
LOCK_WANTED = CAPSULE_LOCK.with_name(CAPSULE_LOCK.name + ".wanted")
# One file per thing currently using the disk -- a backup, a browse session, a
# models put-back, a restore. Unlock adds one, lock drops one, and the disk is
# only really locked once the last one has gone. Before this, whoever finished
# first locked the disk out from under everyone else; a browse session closing
# mid-put-back threw away gigabytes that were already down.
#
# They live here and not on the backup disk itself for the obvious reason: a
# mark on the disk cannot be read while the disk is locked. /run is cleared
# when the Pi reboots, which is right -- a reboot means nobody is holding it.
HOLDERS = CAPSULE_LOCK.with_name(CAPSULE_LOCK.name + ".holders")
HOLD_ID = re.compile(r"^[0-9a-f]{16}$")
# A mark not refreshed in this long belongs to something that died without
# saying so. Long enough that an ordinary slow patch never trips it.
HOLD_STALE = 600
# ...and even with nothing holding it, the disk is only locked once it has also
# been quiet this long. Both, so a transfer that is alive but not heartbeating
# is never cut off mid-flight.
IDLE_LOCK = 600
IO_STAMP = CAPSULE_LOCK.with_name(CAPSULE_LOCK.name + ".io")
# The disk's health checks (lib/health.py): kept off the disk itself, so the
# laptop can ask how it is while it's locked.
HEALTH = (Path(os.environ.get("OMA_GATE_HEALTH") or "/tmp/oma-gate-test.health.json") if TEST
          else Path("/var/lib/oma-gate/health.json"))
MAX_CHECK_MINUTES = 12 * 60


def keys_file() -> Path:
    if TEST:
        return Path(os.environ.get("OMA_GATE_KEYS", ""))
    return Path(pwd.getpwnam(ACCOUNT).pw_dir, ".ssh", "authorized_keys")


class Refused(Exception):
    pass


def log(msg: str) -> None:
    syslog.syslog(syslog.LOG_INFO, msg)


def load_uuid() -> str:
    try:
        for line in CONF.read_text(encoding="utf-8").splitlines():
            key, _, val = line.partition("=")
            if key.strip() == "uuid" and UUID.match(val.strip()):
                return val.strip()
    except OSError:
        pass
    raise Refused(f"no capsule configured in {CONF}")


def run(*cmd: str, stdin: bytes | None = None) -> None:
    r = subprocess.run(list(cmd), input=stdin, stdout=sys.stderr)
    if r.returncode != 0:
        raise Refused(f"{cmd[0]} failed (exit {r.returncode})")


def device() -> Path:
    return Path("/dev/disk/by-uuid") / load_uuid()


@contextmanager
def capsule_turn():
    """Hold the capsule lock: unlock and lock run one at a time, in order."""
    fd = os.open(str(CAPSULE_LOCK), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def holders_seen() -> list[str]:
    """Whatever is there, pruning nothing -- for status, which does not take
    the turn and must not change anything."""
    try:
        return sorted(p.name for p in HOLDERS.iterdir() if HOLD_ID.match(p.name))
    except OSError:
        return []


def holders_live() -> list[str]:
    """The marks still worth honouring, dropping any that have gone stale.

    Always called with the capsule turn held, so nothing is being added or
    removed underneath it.
    """
    now = time.time()
    live = []
    for name in holders_seen():
        f = HOLDERS / name
        try:
            if now - f.stat().st_mtime <= HOLD_STALE:
                live.append(name)
            else:
                f.unlink()
                log(f"dropped a mark nothing refreshed: {name}")
        except OSError:
            pass
    return live


def hold_add() -> str:
    """The gate hands out the id, so a caller can only ever drop its own."""
    HOLDERS.mkdir(parents=True, exist_ok=True)
    os.chmod(HOLDERS, 0o700)
    hid = secrets.token_hex(8)
    (HOLDERS / hid).touch()
    return hid


def hold_drop(hid: str) -> None:
    try:
        (HOLDERS / hid).unlink()
    except OSError:
        pass


def hold_drop_all() -> None:
    for name in holders_live():
        hold_drop(name)


def capsule_io() -> str | None:
    """The disk's own read/write counters, or None if it isn't open."""
    try:
        dm = os.path.basename(os.path.realpath(f"/dev/mapper/{MAPPER}"))
        return Path("/sys/block", dm, "stat").read_text(encoding="utf-8").strip()
    except OSError:
        return None


def mapper_open() -> bool:
    return Path("/dev/mapper", MAPPER).exists()


def mounted() -> bool:
    if TEST:
        return MOUNT.is_dir()
    r = subprocess.run(["findmnt", "-n", "-o", "SOURCE", str(MOUNT)], capture_output=True, text=True)
    return r.stdout.strip().split("[")[0] == f"/dev/mapper/{MAPPER}"


def require_mounted() -> None:
    if not mounted():
        raise Refused("capsule is locked (run unlock first)")


def target(rel: str, depth: int = 2) -> Path:
    """A path inside the capsule's top-level layout, e.g. home/20260919T010308Z."""
    parts = rel.split("/")
    if not (1 <= len(parts) <= depth) or parts[0] not in TOP_DIRS or not all(NAME.match(p) for p in parts):
        raise Refused(f"path not allowed: {rel!r}")
    for i in range(1, len(parts) + 1):
        if MOUNT.joinpath(*parts[:i]).is_symlink():
            raise Refused(f"path not allowed (symlink): {rel!r}")
    return MOUNT.joinpath(*parts)


def is_subvolume(p: Path) -> bool:
    if TEST:
        return p.is_dir()
    try:
        return p.stat().st_ino == 256
    except OSError:
        return False


def shared(name: str):
    """A module installed beside the gatekeeper (in the repo, from ../lib)."""
    sys.path[:0] = [str(LIB), str(LIB.parent / "lib")]
    return __import__(name)


def scrub_busy() -> bool:
    """A health check is reading the disk: it must not be locked under it,
    and the sweep pauses it once tonight's time is up."""
    if not mounted():
        return False
    health = shared("health")
    if health.scrub_status(str(MOUNT))["status"] != "running":
        return False
    return True


def settle_health(stop: bool) -> None:
    try:
        shared("health").settle(str(MOUNT), HEALTH, stop=stop)
    except OSError as e:
        log(f"couldn't record the health check: {e}")


def v_version(args: list[str]) -> None:
    print(VERSION)


def v_status(args: list[str]) -> None:
    print(json.dumps({
        "version": VERSION,
        "uuid": load_uuid(),
        "present": device().exists(),
        "unlocked": mapper_open(),
        "mounted": mounted(),
        "holders": len(holders_seen()),
        "checking": HEALTH.exists() and bool(shared("health").load(HEALTH).get("running")),
    }))


def v_unlock(args: list[str]) -> None:
    # Read the key before taking the turn: the client is waiting on this pipe,
    # and a slow reader shouldn't hold the lock while a lock request queues.
    # It is read every time, even when the disk already looks open. Deciding
    # that on the strength of a look taken outside the turn is a race: a lock
    # queued behind this unlock can close the disk while this call is still
    # waiting, and the key it then needs is the one it chose not to read and
    # can no longer ask for. Closing one restore point and opening another is
    # all it takes.
    key = sys.stdin.buffer.read(MAX_KEY + 1)
    started = time.time()
    with capsule_turn():
        if not mounted():
            dev = device()
            if not dev.exists():
                raise Refused("capsule not plugged in (or not powered)")
            if not mapper_open():
                if not key or len(key) > MAX_KEY:
                    raise Refused("unlock key missing or too large")
                run("cryptsetup", "open", "--key-file=-", str(dev), MAPPER, stdin=key)
            MOUNT.mkdir(parents=True, exist_ok=True)
            run("mount", "-o", "rw,noatime,compress=zstd:1", f"/dev/mapper/{MAPPER}", str(MOUNT))
            os.chmod(MOUNT, 0o755)
            log("capsule unlocked")
        # A forced lock asked for while this was in flight still wins: it is
        # the one way to say "everybody off, now". Say so rather than hand back
        # a mark on a disk that is closing.
        if lock_wanted_since(started):
            hold_drop_all()
            do_lock()
            log("locked again: a forced lock was waiting behind this unlock")
            raise Refused("the disk was locked while this was opening; try again")
        # The mark goes on inside the turn, so nothing can slip between the
        # unlock landing and this caller being counted among its users.
        hid = hold_add()
        print(hid)


def lock_wanted_since(started: float) -> bool:
    """A lock request queued up after this unlock began. Old notes are junk
    from a request that died long ago, so they get cleared, not obeyed."""
    try:
        wanted = LOCK_WANTED.stat().st_mtime
    except OSError:
        return False
    fresh = wanted >= started
    try:
        LOCK_WANTED.unlink()
    except OSError:
        pass
    return fresh


def sweep_armed() -> bool:
    """Leaving the disk open is only safe while something will close it."""
    if TEST:
        return os.environ.get("OMA_GATE_SWEEP", "1") == "1"
    r = subprocess.run(["systemctl", "is-active", "--quiet", "oma-gate-sweep.timer"])
    return r.returncode == 0


def do_lock() -> None:
    # A health check under way is paused, not lost: the next night resumes it.
    if scrub_busy():
        settle_health(stop=True)
    if mounted():
        run("sync")
        run("umount", str(MOUNT))
    if mapper_open():
        run("cryptsetup", "close", MAPPER)


def v_lock(args: list[str]) -> None:
    """lock [HOLD] -- let go of one mark, or of everything.

    With a hold id this only lets go of that one caller. When it was the
    last, the disk still stays open: the sweep locks it after IDLE_LOCK of
    nobody holding it and nothing moving. Unlocking costs ~20 seconds of
    key stretching on a Pi (no AES instructions), and picking what to
    leave out, then restoring, then browsing used to pay that three times
    over in as many minutes. Without an id it is the blunt "everybody off"
    that the rescue stick and a person clearing up by hand need, and that
    still locks at once.
    """
    hid = args[0] if args else ""
    if hid and not HOLD_ID.match(hid):
        raise Refused("that is not a hold id")
    if not hid:
        # The note goes down before queueing: if this request is killed while
        # it waits, the unlock it is chasing still finds it and locks up
        # afterwards.
        try:
            LOCK_WANTED.touch()
        except OSError:
            pass
    with capsule_turn():
        if hid:
            hold_drop(hid)
            still = holders_live()
            if still:
                log(f"let go of {hid}; {len(still)} still using the disk")
                return
            if sweep_armed():
                # Start the quiet clock from now, not from whenever the sweep
                # last looked.
                IO_STAMP.unlink(missing_ok=True)
                log(f"let go of {hid}; nobody on the disk, it locks after {IDLE_LOCK // 60} quiet minutes")
                return
            # No idle lock running: nothing would ever close it, so close it now.
        else:
            hold_drop_all()
        do_lock()
        try:
            LOCK_WANTED.unlink()
        except OSError:
            pass
        log("capsule locked")


def v_hold(args: list[str]) -> None:
    """hold HOLD -- still here. A mark nothing refreshes is dropped once it is
    HOLD_STALE old, so anything long-running says this as it goes."""
    (hid,) = args
    if not HOLD_ID.match(hid):
        raise Refused("that is not a hold id")
    try:
        os.utime(HOLDERS / hid, None)
    except OSError:
        raise Refused("that hold has gone -- unlock again to take a new one")


def v_sweep(args: list[str]) -> None:
    """The safety net, from a timer here on the Pi: lock a disk nobody is on.

    Both things have to be true -- no live marks, and no disk activity for
    IDLE_LOCK -- so something that is alive but has stopped saying so is never
    cut off mid-transfer. It only ever closes a disk; it never opens one.
    """
    with capsule_turn():
        if not mapper_open() and not mounted():
            return
        if HEALTH.exists() and mounted():
            record = shared("health").load(HEALTH)
            if record.get("running"):
                if not scrub_busy():
                    settle_health(stop=False)
                elif time.time() >= float(record.get("deadline") or 0):
                    settle_health(stop=True)
                    log("health check paused for tonight; the next one carries on from here")
                else:
                    IO_STAMP.unlink(missing_ok=True)
                    return
        if holders_live():
            IO_STAMP.unlink(missing_ok=True)
            return
        now = time.time()
        io = capsule_io()
        quiet_since, was = None, None
        try:
            head, _, rest = IO_STAMP.read_text(encoding="utf-8").partition("\n")
            quiet_since, was = float(head), rest
        except (OSError, ValueError):
            pass
        if io is not None and was is not None and io == was:
            if now - quiet_since >= IDLE_LOCK:
                do_lock()
                IO_STAMP.unlink(missing_ok=True)
                log("locked: nothing holding it, and quiet for 10 minutes")
            return
        # It moved, or this is the first look: start the clock again.
        try:
            IO_STAMP.write_text(f"{now}\n{io or ''}", encoding="utf-8")
        except OSError:
            pass


def v_subvol_create(args: list[str]) -> None:
    require_mounted()
    (p,) = map(target, args)
    if is_subvolume(p):
        return
    if p.exists():
        raise Refused(f"{args[0]} exists but is not a btrfs subvolume")
    p.parent.mkdir(parents=True, exist_ok=True)
    run("btrfs", "subvolume", "create", str(p))


def v_snapshot(args: list[str]) -> None:
    require_mounted()
    src, dst = map(target, args)
    if dst.exists():
        raise Refused(f"{args[1]} already exists")
    run("btrfs", "subvolume", "snapshot", "-r", str(src), str(dst))


def v_reseed(args: list[str]) -> None:
    """reseed KIND TS -- make KIND/current a writable copy of restore point TS.

    When another system has been backing up to this disk, its files are in
    the working copy; copying this system's back over the top would store
    all of them a second time, because the disk can't tell they match the
    ones already in this system's own restore points. A snapshot of one of
    those shares every byte with it instead. Built beside the old copy and
    swapped in, so an interruption never leaves no working copy at all.
    """
    require_mounted()
    kind, ts = args
    if kind not in ("os", "home", "esp") or not STAMP.match(ts):
        raise Refused(f"can't rebuild {kind!r} from {ts!r}")
    src = target(f"{kind}/{ts}")
    if not is_subvolume(src):
        raise Refused(f"{kind}/{ts} is not a restore point here")
    cur = target(f"{kind}/current")
    new = target(f"{kind}/current.new")
    if new.exists():
        if not is_subvolume(new):
            raise Refused(f"{kind}/current.new exists but is not a btrfs subvolume")
        run("btrfs", "subvolume", "delete", str(new))
    run("btrfs", "subvolume", "snapshot", str(src), str(new))
    if cur.exists():
        if not is_subvolume(cur):
            raise Refused(f"{kind}/current exists but is not a btrfs subvolume")
        run("btrfs", "subvolume", "delete", str(cur))
    os.rename(new, cur)
    log(f"rebuilt {kind}/current from {ts}")


def v_health_start(args: list[str]) -> None:
    """health-start MINUTES -- tonight's slice of the disk's health check:
    carries on the pass where the last night stopped, in the background, at
    idle priority. The sweep pauses it after MINUTES, and keeps the disk open
    until then even once the laptop has let go of it."""
    require_mounted()
    try:
        minutes = int(args[0])
    except ValueError:
        raise Refused("health-start: how many minutes?")
    if not 1 <= minutes <= MAX_CHECK_MINUTES:
        raise Refused(f"health-start: between 1 and {MAX_CHECK_MINUTES} minutes")
    health = shared("health")
    record = health.load(HEALTH)
    if record.get("uuid") != load_uuid():
        # Another disk than last time: its checks start from nothing.
        health.save(HEALTH, {"uuid": load_uuid()})
    health.start(str(MOUNT), HEALTH, minutes)
    log(f"health check started for up to {minutes} minutes")
    print(json.dumps(health.show(HEALTH)))


def v_health(args: list[str]) -> None:
    """health -- how the disk's checks have gone, as JSON. Works locked."""
    health = shared("health")
    if HEALTH.exists() and mounted() and health.load(HEALTH).get("running"):
        settle_health(stop=False)
    record = health.show(HEALTH)
    if record.get("uuid") not in (None, load_uuid()):
        record = {"uuid": load_uuid(), "state": "unknown"}
    if record.get("running") and not mounted():
        # The Pi restarted mid-check: the next night picks it up again.
        record["running"] = False
    print(json.dumps(record))


def v_reuse(args: list[str]) -> None:
    """reuse KIND TS [TS ...] -- files already in those restore points go into
    KIND/current as clones of the stored copy, instead of being sent and
    stored all over again. The list comes on stdin (see lib/reuse.py)."""
    require_mounted()
    if len(args) < 2:
        raise Refused("reuse: which restore points?")
    reuse = shared("reuse")
    try:
        files, total = reuse.reuse(str(MOUNT), args[0], args[1:], sys.stdin.buffer)
    except reuse.Refused as e:
        raise Refused(str(e))
    if files:
        log(f"reused {files} files ({total} bytes) in {args[0]}/current from older restore points")
    print(files, total)


def v_set_writable(args: list[str]) -> None:
    require_mounted()
    (p,) = map(target, args)
    run("btrfs", "property", "set", "-ts", str(p), "ro", "false")


def v_mkdir(args: list[str]) -> None:
    require_mounted()
    (p,) = map(target, args)
    p.mkdir(parents=True, exist_ok=True)


def v_exists(args: list[str]) -> None:
    require_mounted()
    (p,) = map(target, args)
    if not p.exists():
        sys.exit(1)


def v_chmod755(args: list[str]) -> None:
    require_mounted()
    # Depth 3 so a restore point's user folder (home/<ts>/<user>) can be opened.
    for p in (target(a, depth=3) for a in args):
        try:
            os.chmod(p, 0o755)
        except OSError as e:
            log(f"chmod skipped: {e}")


def v_list(args: list[str]) -> None:
    require_mounted()
    # Installed side by side on the Pi; in the repo it lives in ../lib.
    sys.path[:0] = [str(LIB), str(LIB.parent / "lib")]
    from list_snapshots import scan

    print(json.dumps(scan(MOUNT)))


def v_write_meta(args: list[str]) -> None:
    require_mounted()
    raw = sys.stdin.buffer.read(MAX_META + 1)
    if len(raw) > MAX_META:
        raise Refused("machine.json too large")
    try:
        data = json.loads(raw)
    except ValueError:
        raise Refused("machine.json is not valid JSON")
    meta = target("meta")
    meta.mkdir(exist_ok=True)
    tmp = meta / "machine.json.tmp"
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o644)
    tmp.replace(meta / "machine.json")


def v_df(args: list[str]) -> None:
    require_mounted()
    du = shutil.disk_usage(MOUNT)
    print(f"{du.total} {du.free}")


def restore_points() -> list[str]:
    stamps: set[str] = set()
    for kind in ("os", "home"):
        try:
            stamps.update(p.name for p in (MOUNT / kind).iterdir() if STAMP.match(p.name))
        except OSError:
            pass
    return sorted(stamps)


def v_delete(args: list[str]) -> None:
    """Delete one restore point. Never the newest, whatever the caller asks."""
    require_mounted()
    ts = args[0]
    if not STAMP.match(ts):
        raise Refused(f"not a restore point: {ts!r}")
    points = restore_points()
    if ts not in points:
        raise Refused(f"no restore point {ts}")
    if ts == points[-1]:
        raise Refused("refusing to delete the newest restore point")
    for kind in ("os", "home"):
        p = target(f"{kind}/{ts}")
        if p.exists():
            if not is_subvolume(p):
                raise Refused(f"{kind}/{ts} is not a btrfs subvolume")
            run("btrfs", "subvolume", "delete", str(p))
    # Boot files are a snapshot of esp/current since v4; older restore
    # points have a plain folder.
    esp = target(f"esp/{ts}")
    if is_subvolume(esp):
        run("btrfs", "subvolume", "delete", str(esp))
    elif esp.is_dir():
        shutil.rmtree(esp)
    # Its manifest (sizes for a restore's progress bars) goes with it. The
    # laptop writes it with plain rsync, so older gatekeepers never knew of
    # it and simply leave it behind.
    target(f"meta/{ts}.json").unlink(missing_ok=True)
    log(f"deleted restore point {ts}")


def v_settle(args: list[str]) -> None:
    require_mounted()
    run("btrfs", "subvolume", "sync", str(MOUNT))


def v_check_pass(args: list[str]) -> None:
    """Exit 0 if the password on stdin opens the backup disk (nothing is unlocked)."""
    dev = device()
    if not dev.exists():
        raise Refused("capsule not plugged in (or not powered)")
    key = sys.stdin.buffer.read(MAX_KEY + 1)
    if not key or len(key) > MAX_KEY:
        raise Refused("password missing or too large")
    r = subprocess.run(["cryptsetup", "open", "--test-passphrase", "--key-file=-", str(dev)],
                       input=key, stdout=sys.stderr)
    if r.returncode != 0:
        raise Refused("that password doesn't open the backup disk")


def v_addresses(args: list[str]) -> None:
    """This Pi's IP addresses, so a rescue stick can find it without DNS."""
    r = subprocess.run(["ip", "-o", "-4", "addr", "show", "scope", "global"], capture_output=True, text=True)
    addrs = [f[3].split("/")[0] for f in (line.split() for line in r.stdout.splitlines()) if len(f) > 3]
    print(json.dumps(addrs))


def write_keys(lines: list[str]) -> None:
    path = keys_file()
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text("".join(line + "\n" for line in lines), encoding="utf-8")
    os.chmod(tmp, 0o600)
    if not TEST:
        pw = pwd.getpwnam(ACCOUNT)
        os.chown(tmp, pw.pw_uid, pw.pw_gid)
    tmp.replace(path)


def other_keys() -> list[str]:
    try:
        lines = keys_file().read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return []
    return [line for line in lines if line.strip() and not line.rstrip().endswith(" " + RESCUE_TAG)]


def v_set_rescue_key(args: list[str]) -> None:
    """Install the rescue stick's key, replacing any older stick's key."""
    key = sys.stdin.read(MAX_KEY + 1).strip()
    if not PUBKEY.match(key):
        raise Refused("not an ssh-ed25519 public key")
    gate = str(Path(__file__).resolve())
    write_keys(other_keys() + [f'restrict,command="sudo -n {gate} --rescue" {key} {RESCUE_TAG}'])
    log("rescue stick key installed")


def v_revoke_rescue_key(args: list[str]) -> None:
    write_keys(other_keys())
    log("rescue stick key removed")


SFTP_SERVERS = ("/usr/lib/openssh/sftp-server", "/usr/libexec/openssh/sftp-server", "/usr/lib/ssh/sftp-server")


def v_browse(args: list[str]) -> None:
    """Serve one user's home folder from one restore point, read-only, over
    SFTP (the laptop mounts it with sshfs). sftp-server runs in a bubblewrap
    sandbox where only /usr and that folder exist, so the connection can't
    reach anything else on this machine."""
    require_mounted()
    ts, user = args
    if not STAMP.match(ts):
        raise Refused(f"not a restore point: {ts!r}")
    folder = target(f"home/{ts}/{user}", depth=3)
    if not folder.is_dir():
        raise Refused(f"no home folder for {user} in {ts}")
    bwrap = shutil.which("bwrap")
    sftp = next((s for s in SFTP_SERVERS if os.access(s, os.X_OK)), None)
    if not bwrap or not sftp:
        raise Refused("browsing needs bubblewrap and sftp-server here: update this Pi (pi-setup.sh --update)")
    sandbox = [bwrap, "--ro-bind", "/usr", "/usr"]
    for link in ("lib", "lib64", "bin", "sbin"):
        if Path("/usr", link).exists():
            sandbox += ["--symlink", f"usr/{link}", f"/{link}"]
    # No user namespace (--unshare-user): files must keep their real owners,
    # or the laptop would see them all as "nobody" and refuse to open them.
    # sftp-server looks up its own account; passwd/group are world-readable
    # account names only (hashes live in shadow, which stays out).
    sandbox += [
        "--ro-bind", "/etc/passwd", "/etc/passwd",
        "--ro-bind", "/etc/group", "/etc/group",
        "--ro-bind", str(folder), "/data",
        "--dev", "/dev", "--proc", "/proc",
        "--unshare-ipc", "--unshare-pid", "--unshare-net", "--unshare-uts",
        "--die-with-parent", "--chdir", "/data",
        sftp, "-R", "-d", "/data",
    ]
    log(f"browsing {ts} for {user}")
    os.execv(bwrap, sandbox)


def v_rsync(argv: list[str], original: str) -> None:
    if argv[:2] != ["rsync", "--server"]:
        raise Refused("only rsync server mode is allowed")
    require_mounted()
    env = dict(os.environ, SSH_ORIGINAL_COMMAND=original)
    ro = ["-ro"] if RESCUE else []
    os.execvpe(LOW_PRIORITY[0], LOW_PRIORITY + ["rrsync", *ro, str(MOUNT)], env)


VERBS = {
    "version": (v_version, 0),
    "status": (v_status, 0),
    "unlock": (v_unlock, 0),
    "lock": (v_lock, (0, 1)),
    "hold": (v_hold, 1),
    "sweep": (v_sweep, 0),
    "subvol-create": (v_subvol_create, 1),
    "snapshot": (v_snapshot, 2),
    "set-writable": (v_set_writable, 1),
    "reseed": (v_reseed, 2),
    "reuse": (v_reuse, None),
    "health-start": (v_health_start, 1),
    "health": (v_health, 0),
    "mkdir": (v_mkdir, 1),
    "exists": (v_exists, 1),
    "chmod755": (v_chmod755, None),
    "list": (v_list, 0),
    "write-meta": (v_write_meta, 0),
    "df": (v_df, 0),
    "delete": (v_delete, 1),
    "settle": (v_settle, 0),
    "check-pass": (v_check_pass, 0),
    "addresses": (v_addresses, 0),
    "set-rescue-key": (v_set_rescue_key, 0),
    "revoke-rescue-key": (v_revoke_rescue_key, 0),
    "browse": (v_browse, 2),
    # sshfs runs a custom SFTP server only if its name contains a "/".
    "/browse": (v_browse, 2),
}

# A rescue stick only ever reads: rsync is forced read-only in v_rsync.
RESCUE_VERBS = {v: VERBS[v] for v in ("version", "status", "unlock", "lock", "hold", "list", "exists")}


def main() -> int:
    syslog.openlog("oma-gate-rescue" if RESCUE else "oma-gate")
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    try:
        try:
            argv = shlex.split(original)
        except ValueError:
            raise Refused("unparseable command")
        if not argv:
            raise Refused("no command (interactive logins are not allowed)")
        if argv[0] == "rsync":
            v_rsync(argv, original)
            return 0
        verb = (RESCUE_VERBS if RESCUE else VERBS).get(argv[0])
        if verb is None:
            raise Refused(f"unknown command {argv[0]!r}")
        fn, nargs = verb
        args = argv[1:]
        if isinstance(nargs, tuple):
            ok = len(args) in nargs
        elif nargs is None:
            ok = bool(args)
        else:
            ok = len(args) == nargs
        if not ok:
            raise Refused(f"{argv[0]}: wrong number of arguments")
        fn(args)
        return 0
    except Refused as e:
        log(f"refused: {e} [{original[:200]}]")
        print(f"oma-gate: {e}", file=sys.stderr)
        return 2
    except OSError as e:
        log(f"error: {e} [{original[:200]}]")
        print(f"oma-gate: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
